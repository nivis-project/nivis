<!-- Nivis brand <head> additions: favicon + social preview (og:image /
     twitter:image -> the 1280x640 brand banner). The favicon is site-relative
     via mdBook's {{ path_to_root }}; the OG/Twitter image MUST be an absolute URL
     (social crawlers cannot fetch a relative path) — it points at the deployed
     GitHub Pages project URL. Update this origin if the site moves. -->
<link rel="icon" type="image/svg+xml" href="{{ path_to_root }}favicon.svg">
<link rel="apple-touch-icon" href="{{ path_to_root }}favicon.svg">

<meta property="og:type" content="website">
<meta property="og:site_name" content="Nivis">
<meta property="og:title" content="Nivis — Infrastructure as Nix Code">
<meta property="og:description" content="A Nix-native infrastructure tool where Terraform/OpenTofu provider resources are first-class Nix values.">
<meta property="og:url" content="https://wearetechnative.github.io/nivis/">
<meta property="og:image" content="https://wearetechnative.github.io/nivis/banner.png">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Nivis — Infrastructure as Nix Code">
<meta name="twitter:description" content="A Nix-native infrastructure tool where Terraform/OpenTofu provider resources are first-class Nix values.">
<meta name="twitter:image" content="https://wearetechnative.github.io/nivis/banner.png">

